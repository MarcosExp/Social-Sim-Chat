# Copia este fichero a environment/.env y ajusta lo que necesites.
# No se versiona .env (ver .gitignore) — solo este .env.example.

# --- PostgreSQL ---
POSTGRES_USER=social_sim
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=social_sim_chat
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# 8010 y no 8000: el 8000 suele estar ocupado por otros servicios locales
BACKEND_PORT=8010
DASHBOARD_PORT=8501
# Clave del terapeuta: protege el dashboard-API (/students, /sessions, /predicciones, /modelo, /resumen, /correcciones y
# la lectura/corrección de conversaciones). El chat del menor (POST /conversaciones...) y /health no la piden.
# 'dev-terapeuta-local' es la clave de desarrollo que documenta el README (cámbiala en un despliegue real). Si la borras,
# compose usa esa misma. Fuera de compose, vacía = API abierta.
API_KEY_TERAPEUTA=dev-terapeuta-local
ENV=development
# Cadena de conexión completa, derivada de las variables de arriba.
# Si cambias las variables de Postgres, actualiza esta línea a mano.
DATABASE_URL=postgresql+psycopg2://social_sim:change_me_local_dev@db:5432/social_sim_chat

# --- Motor conversacional (LLM local) ---
# "ollama"   -> Ollama con su API nativa (permite think:false y keep_alive). Es el valor por defecto y el que
#               está validado con qwen3:14b.
# "openai"   -> cualquier servidor con API compatible con OpenAI (/v1/chat/completions): el /v1 de Ollama, vLLM,
#               LM Studio, TabbyAPI... Es la interfaz que fija NF2 para poder sustituir el motor local.
# "tabbyapi" -> alias histórico de "openai" con las variables TABBYAPI_* (stack TabbyAPI/ExLlamaV3 externo, p. ej. en
#               tu PC con la GPU dedicada). NO se levanta en este docker-compose: aquí solo se referencia como endpoint.
LLM_PROVIDER=ollama

# API compatible con OpenAI (usado cuando LLM_PROVIDER=openai)
# Por defecto apunta al /v1 del Ollama del host, así se prueba sin instalar nada más:
#   LLM_PROVIDER=openai  y  make smoke
# URL = raíz del servidor, SIN /v1. Los nombres son LLM_COMPAT_* a propósito: no se usa OPENAI_API_KEY del entorno
# para no enviar una clave real de OpenAI a un servidor local (los datos son de menores).
LLM_COMPAT_URL=http://host.docker.internal:11434
LLM_COMPAT_MODEL=qwen3:14b
# Déjala vacía si el servidor no pide clave; si la pide, se envía como «Authorization: Bearer ...».
LLM_COMPAT_API_KEY=
# El evaluador pide el JSON con response_format=json_schema. Si tu servidor lo rechaza (HTTP 400), pon false:
# el cliente extrae el JSON del texto igualmente.
LLM_COMPAT_RESPONSE_FORMAT=true
# OJO con qwen3 por esta vía: no se puede enviar think:false, así que el modelo puede razonar (más lento) y gastar el tope
# de tokens. Con qwen3 usa LLM_PROVIDER=ollama; con un modelo sin razonamiento, esta vía va bien.

# Ollama (usado cuando LLM_PROVIDER=ollama)
# Ollama del host Windows (escucha en 0.0.0.0:11434). Si usas el del compose: http://ollama:11434
# y arranca con `--profile ollama-local`.
# OJO: se llama OLLAMA_URL y no OLLAMA_HOST a propósito: OLLAMA_HOST=0.0.0.0 suele estar definida en Windows para el propio Ollama
# y, en docker compose, el entorno del shell gana a este fichero (el backend recibía "0.0.0.0" sin http://).
OLLAMA_URL=http://host.docker.internal:11434
# Modelo por defecto. Descárgalo tras el primer `docker compose up` con:
#   make pull-model
OLLAMA_MODEL=qwen3:14b
# qwen3 razona por defecto; para conversar se apaga (la API nativa de Ollama acepta think:false).
OLLAMA_THINK=false
# Contexto explícito: con el valor por defecto de Ollama los prompts largos se truncan en silencio.
# 8192 cabe de sobra con qwen3:14b en 16 GB de VRAM; si lo subes, vigila la memoria.
OLLAMA_NUM_CTX=8192
# Mantiene el modelo en VRAM entre turnos (evita recargarlo ~10-20 s en cada conversación).
# Se llama LLM_KEEP_ALIVE y no OLLAMA_KEEP_ALIVE por la misma razón que OLLAMA_URL (colisión con el entorno de Windows).
LLM_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=200
# Tiempo máximo por petición, reintentos ante fallo de conexión/5xx (con espera exponencial) y
# espera máxima en cola: el backend envía UNA petición a la vez a Ollama (un solo worker de uvicorn).
OLLAMA_TIMEOUT_S=120
OLLAMA_MAX_REINTENTOS=2
OLLAMA_REINTENTO_ESPERA_S=0.5
OLLAMA_COLA_TIMEOUT_S=120

# TabbyAPI (usado cuando LLM_PROVIDER=tabbyapi)
# host.docker.internal resuelve al host de Windows/Mac automáticamente; en
# Linux hace falta el extra_hosts que ya trae el docker-compose. Si ejecutas
# el backend FUERA de Docker directamente en el mismo PC Windows donde corre
# TabbyAPI, usa simplemente http://localhost:5000 en vez de host.docker.internal.
TABBYAPI_HOST=http://host.docker.internal:5000
# Modelo DENSO con el que conviene hablar aquí (chat/tutor, no código):
# Qwen3.8-27B-EXL3-3.0bpw. OJO: el config.yml de tu TabbyAPI carga por
# defecto Qwen3-Coder-30B-A3B-EXL3-3.5bpw (modelo de código para tu agente
# de terminal) — para este proyecto hay que cambiar `model_name` en tu
# config.yml a Qwen3.8-27B-EXL3-3.0bpw (+ vision: true si quieres usarlo
# también para imágenes) antes de arrancar TabbyAPI, o cargarlo en caliente
# con `POST /v1/model/load` sin reiniciar.
TABBYAPI_MODEL=Qwen3.8-27B-EXL3-3.0bpw
# Valor del campo `api_key` de tu api_tokens.yml (no admin_key). El backend
# ya lo manda como cabecera `x-api-key` — déjalo en blanco solo si arrancaste
# TabbyAPI con `disable_auth: true`.
TABBYAPI_API_KEY=
