erDiagram
    student_profile_sim ||--o{ session_data : "tiene sesiones"
    student_profile_sim ||--o{ conversacion : "mantiene"
    conversacion ||--o| session_data : "origina (obligatorio si origen=real; opcional en sinteticas, mismo origen, 013)"
    conversacion ||--o{ conversacion_turno : "contiene turnos"
    conversacion_turno }o--|| turn_data : "agrupada por figura (vista, ADR-002)"
    student_profile_sim ||--o{ classifier_predictions : "predice"
    session_data ||--o{ classifier_predictions : "es predicha por (historial por version)"
    session_data ||--o{ correccion_log : "correcciones de la sesion"
    conversacion ||--o{ correccion_log : "correcciones de turnos"

    student_profile_sim {
        text student_id PK "pseudonimizado"
        text arquetipo "A / B / C / D"
        text competencia_objetivo "solo generacion, no es feature"
        text trayectoria_disenada "progreso / estancamiento / regresion, solo generacion"
        text nivel_ruido "bajo / medio / alto"
        boolean ambiguo "trayectoria ambigua"
        text tipo_ambiguo
        int sesion_inicio_evento "sesion desde la que aplica la trayectoria"
        text tramo_edad "6-8 / 8-10 / 10-12"
        int n_sesiones
    }

    session_data {
        uuid session_id PK
        text student_id FK
        int sesion_num UK "UNIQUE con student_id; las reales continuan la numeracion del alumno"
        text origen "sintetico / real"
        uuid conversacion_id FK "obligatorio si origen=real, opcional si sintetico (013), UNIQUE parcial"
        date fecha
        text competencia "para el dashboard, no es feature"
        text personaje
        real amlu "feature"
        real latencia_pragmatica_ms "feature"
        real irc_pct "feature"
        real pepe "feature"
        real pct_det "feature"
        real pct_det_observado_en_turnos
        int n_turnos_menor "trazabilidad del calculo"
        int n_turnos_evaluados
        int n_figuras
        int n_turnos_amlu
        int lpp_intento1
        int lpp_intento2
        text definicion_version "version de la definicion de metricas"
        text etiqueta_real_disenada "verdad de diseno, obligatoria si origen=sintetico, nunca feature"
        text etiqueta_prediccion "ultima prediccion del clasificador (campo del ER), solo sinteticas; historial en classifier_predictions"
        real confianza_prediccion
        text etiqueta_corregida "correccion del terapeuta"
        text nota_clinica "sensible en caso real (RGPD): solo en GET /sessions/{id}, nunca en listados"
    }

    classifier_predictions {
        bigint id PK
        text student_id FK
        uuid session_id FK
        text modelo_version UK "UNIQUE con session_id"
        text etiqueta_predicha "progreso / estancamiento / regresion"
        real confianza
        boolean es_estancamiento_operacional "alerta del dashboard"
        timestamptz predicted_at
    }

    conversacion {
        uuid conversacion_id PK
        text student_id FK
        text competencia
        text personaje
        text alias
        text estado "en_curso / terminada"
        text nodo_actual
        int intento
        text guion_version
        text modelo "LLM usado"
        boolean es_prueba
        text origen "real / sintetico; sintetico implica es_prueba (013)"
    }

    correccion_log {
        bigint id PK
        timestamptz fecha
        text autor "declarado en X-Terapeuta, NO verificado"
        text tipo "turno / sesion"
        uuid conversacion_id FK
        int orden
        uuid session_id FK
        text campo "accuracy_corregido / etiqueta_corregida / nota_clinica"
        text valor_anterior
        text valor_nuevo "vacio en nota_clinica: no se guarda su contenido"
    }

    conversacion_turno {
        bigint id PK
        uuid conversacion_id FK
        int orden UK "UNIQUE con conversacion_id"
        text rol "bot / menor"
        text nodo "figura o paso del guion"
        text tipo "apertura / competencia"
        int intento "1 o 2; una fila por intento (ADR-002)"
        text texto "sensible en caso real (RGPD)"
        smallint evaluacion "0 / 1 / 2"
        text evaluacion_origen "llm / heuristica / guarda_inyeccion / sintetico"
        smallint accuracy_corregido "efectivo = COALESCE(accuracy_corregido, evaluacion)"
        int ayudas_solicitadas
        boolean iniciativa "el menor pregunta o aporta contenido no pedido"
        text rama
        int latencia_ms
        int llm_ms
        text evaluador_version
        text guarda_patron
    }

    turn_data {
        bigint turn_id "VISTA: una fila por figura, no es tabla"
        uuid session_id "NULL si no hay sesion"
        uuid conversacion_id
        int turno_num
        text tipo "apertura / competencia"
        text figura "= nodo"
        text rama
        smallint accuracy_score "2 a la primera, 1 tras la ayuda, 0 resto"
        smallint accuracy_corregido "NULL si el terapeuta no corrigio"
        smallint accuracy_efectivo "COALESCE(corregido, score)"
        int ayudas_solicitadas
        int n_intentos
        int latencia_ms "intento 1"
        int latencia_ms_intento2
        boolean iniciativa
        text texto_respuesta "sensible en caso real (RGPD)"
        boolean es_prueba
        boolean hubo_respuesta "siempre TRUE: no se registran silencios del menor (limite conocido)"
    }
