flowchart TD

    subgraph P["Capa de presentación"]
        Menor(["Menor<br/>(alumno simulado)"])
        Front["Frontend chatbot<br/>/chat (HTML/JS sobre la API)"]
        Terapeuta(["Terapeuta"])
        Dash["Dashboard Streamlit<br/>métricas, alertas, transcripciones,<br/>consola de correcciones"]
    end

    subgraph A["Capa de aplicación"]
        Back["Backend FastAPI<br/>conversación · métricas · correcciones + historial ·<br/>lectura de predicciones y modelo ·<br/>clave del terapeuta · puerta de predicción real (cerrada)"]
    end

    subgraph S["Capa de inteligencia y datos"]
        LLM["LLM local (Ollama / TabbyAPI)<br/>valoración 0/1/2 y variación de frase"]
        DB[("PostgreSQL<br/>perfiles · sesiones (origen) · conversaciones · turnos<br/>vista turn_data · predicciones · correccion_log")]
        Modelo["Clasificador entrenado<br/>classifier.joblib + metrics.json"]
    end

    subgraph O["Entrenamiento offline (por lotes)"]
        Gen["Generador de corpus sintético<br/>config.yaml + seed"]
        Feat["Pipeline de features<br/>(solo origen = sintético)"]
        Train["Entrenamiento y evaluación<br/>split por alumno"]
    end

    Menor <-->|mensajes del chat| Front
    Terapeuta <-->|consulta · corrige · anota| Dash
    Front <-->|REST JSON, abierto sin clave| Back
    Dash <-->|REST JSON + X-API-Key + X-Terapeuta, única vía de datos| Back
    Back <-->|API compatible OpenAI / Ollama| LLM
    Back <-->|SQL| DB
    Back -->|sirve metrics.json| Modelo
    Gen -.->|vuelca el corpus, SQL por lotes| DB
    DB -->|lee sesiones sintéticas| Feat
    Feat --> Train
    Train -.->|guarda modelo y métricas| Modelo
    Train -.->|escribe predicciones| DB

    classDef person fill:#EDEAE3,stroke:#3D3A34,stroke-width:1.5px,color:#3D3A34
    classDef svc fill:#FFFFFF,stroke:#3D3A34,stroke-width:1.2px,color:#3D3A34
    classDef store fill:#F4EDE4,stroke:#8A6D3B,stroke-width:1.2px,color:#3D3A34
    classDef ml fill:#E7EEF1,stroke:#2F5D68,stroke-width:1.2px,color:#3D3A34
    classDef layer fill:#F7F8F8,stroke:#9AA5A8,stroke-width:1px,color:#3D3A34
    class Menor,Terapeuta person
    class Front,Back,Dash,LLM svc
    class DB store
    class Gen,Feat,Train,Modelo ml
    class P,A,S,O layer
