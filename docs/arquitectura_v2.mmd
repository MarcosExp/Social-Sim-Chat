flowchart TD

    subgraph P["Presentación"]
        Menor(["Menor<br/>(alumno simulado)"])
        Chat["Chat HTML/JS en /chat/"]
        Terapeuta(["Terapeuta"])
        Dash["Dashboard Streamlit<br/>métricas, alertas, transcripciones,<br/>consola de correcciones"]
    end

    subgraph A["Aplicación"]
        Back["Backend FastAPI<br/>conversación · métricas · correcciones · /health<br/>comprobación de configuración y precalentamiento al arrancar"]
        Guarda["Guarda de inyecciones"]
    end

    subgraph D["Inteligencia y datos"]
        LLM["LLM local<br/>Ollama qwen3:14b · API compatible OpenAI · simulado"]
        DB[("PostgreSQL 16<br/>session_data (origen) · conversacion_turno · turn_data<br/>predicciones · correccion_log")]
        Modelo["classifier.joblib + metrics.json"]
    end

    subgraph O["Offline por lotes"]
        Gen["Generador de corpus sintético (Marcos)"]
        Train["Entrenamiento + anti-fuga (nueve criterios)"]
    end

    subgraph X["Automatización (Docker Compose + Makefile)"]
        Make["make demo = up + seed + train"]
        Env["preparar-env.sh: .env y clave aleatoria"]
    end

    Menor <-->|mensajes del chat| Chat
    Terapeuta <-->|consulta · corrige · anota| Dash
    Chat <-->|REST, sin clave| Back
    Dash <-->|REST + X-API-Key + X-Terapeuta, única vía de datos| Back
    Back --> Guarda
    Back <-->|valoración 0/1/2 y frase| LLM
    Back <-->|SQL| DB
    Modelo -->|carga el modelo de servicio sin %DET| Back
    Back -->|sirve metrics.json| Modelo
    Gen -.->|carga el corpus, SQL por lotes| DB
    DB -->|solo origen = sintetico| Train
    Train -.->|guarda modelo y métricas| Modelo
    Train -.->|escribe predicciones| DB
    Env --> Make
    Make -.->|levanta y puebla| Back

    classDef person fill:#EDEAE3,stroke:#3D3A34,stroke-width:1.5px,color:#3D3A34
    classDef svc fill:#FFFFFF,stroke:#3D3A34,stroke-width:1.2px,color:#3D3A34
    classDef store fill:#F4EDE4,stroke:#8A6D3B,stroke-width:1.2px,color:#3D3A34
    classDef ml fill:#E7EEF1,stroke:#2F5D68,stroke-width:1.2px,color:#3D3A34
    classDef auto fill:#EEF3E8,stroke:#5B7A3A,stroke-width:1.2px,color:#3D3A34
    classDef layer fill:#F7F8F8,stroke:#9AA5A8,stroke-width:1px,color:#3D3A34
    class Menor,Terapeuta person
    class Chat,Back,Guarda,Dash,LLM svc
    class DB store
    class Gen,Train,Modelo ml
    class Make,Env auto
    class P,A,D,O,X layer
